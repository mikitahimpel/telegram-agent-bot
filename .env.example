# Secrets live in Proton Pass vault "Agents". Never put real values here.
# Run anything that needs them through:  pp run --env-file .env -- <command>
# e.g. pp run --env-file .env -- pnpm exec alchemy deploy --stage dev --yes

# Cloudflare (alchemy reads these when CI=true or no profile is configured)
CLOUDFLARE_API_TOKEN=pass://Agents/telegram-agent-bot-cloudflare/api-token
CLOUDFLARE_ACCOUNT_ID=pass://Agents/telegram-agent-bot-cloudflare/account-id

# Telegram. dev uses its own test bot, prod the real one (switch the item per stage).
TELEGRAM_BOT_TOKEN=pass://Agents/telegram-agent-bot-telegram/bot-token
TELEGRAM_WEBHOOK_SECRET=pass://Agents/telegram-agent-bot-telegram/webhook-secret

# How the claude CLI in the sandbox authenticates:
#   subscription (default) — your Claude plan via `claude setup-token`, set CLAUDE_CODE_OAUTH_TOKEN
#   api_key                — pay-as-you-go Anthropic API, set ANTHROPIC_API_KEY
# Only the secret of the selected mode is required and bound to the Worker.
CLAUDE_AUTH_MODE=subscription
CLAUDE_CODE_OAUTH_TOKEN=pass://Agents/telegram-agent-bot-claude/oauth-token
# ANTHROPIC_API_KEY=pass://Agents/telegram-agent-bot-claude/api-key

# HMAC secret for the short-lived MCP tokens handed to the sandbox.
MCP_TOKEN_SECRET=pass://Agents/telegram-agent-bot-mcp/token-secret

# Plain settings (not secret)
ADMIN_TG_ID=123456789
DAILY_RUN_LIMIT=50
CONTAINER_INSTANCE_TYPE=basic
# ISO date the Claude token was created; setup-token tokens last about a year (reminders at 30/7/1 days).
CLAUDE_TOKEN_ISSUED_AT=2026-11-19

# Smoke test (scripts/smoke.ts)
SMOKE_BASE_URL=https://telegram-agent-bot-dev.example.workers.dev
