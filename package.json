{
  "name": "telegram-agent-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "vp run -r typecheck && tsc -p .",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "e2e": "vp run --filter @bot/car-web e2e",
    "smoke": "node scripts/smoke.ts",
    "infra:deploy": "alchemy deploy --yes",
    "infra:plan": "alchemy plan",
    "infra:destroy": "alchemy destroy --yes",
    "infra:dev": "alchemy dev"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@bot/core-contracts": "workspace:*",
    "@bot/gateway": "workspace:*",
    "@bot/infra-telegram-webhook": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
